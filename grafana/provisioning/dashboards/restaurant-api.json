{
  "title": "RestaurantOrder API",
  "uid": "restaurant-api",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total[1m])",
          "legendFormat": "{{method}} {{endpoint}} {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Request Duration (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{method}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active HTTP Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "http_requests_in_progress",
          "legendFormat": "In Progress"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Error Rate",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total{status_code=~\"5..\"}[5m])",
          "legendFormat": "5xx Errors"
        }
      ]
    }
  ]
}
